{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SQL クエリ例のメタデータ",
  "type": "object",
  "additionalProperties": false,
  "required": ["description", "plan", "tables"],
  "properties": {
    "description": {
      "description": "クエリの簡潔な説明。ディレクトリ名と一致させる。形式: [分析単位][対象別][記録・統計内容][範囲・条件][処理内容]クエリ",
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "plan": {
      "description": "分析の目的・指標定義・設計方針・出力方針を自然言語で書いた箇条書き。1 要素 1 項目で、記号は付けない",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "tables": {
      "description": "SQL が参照するテーブル・ビュー名",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
    }
  }
}
