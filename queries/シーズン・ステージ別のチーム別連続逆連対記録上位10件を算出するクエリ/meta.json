{
  "description": "シーズン・ステージ別のチーム別連続逆連対記録上位10件を算出するクエリ",
  "plan": [
    "各試合でチーム内の最下位順位を特定し、3着または4着の場合を逆連対として判定する",
    "シーズン・ステージ・チーム別に試合を時系列順に並べ、連続する逆連対記録をグループ化する",
    "連続記録の長さ、開始日、終了日を算出し、記録の長い順に上位10件を抽出する",
    "チームは各試合に出場した時点の所属で判定する"
  ],
  "tables": [
    "game_player_result",
    "player",
    "game",
    "season_stage",
    "league_season",
    "team"
  ],
  "checks": {
    "unique": [
      "シーズン年",
      "ステージ",
      "チーム名",
      "記録開始日"
    ],
    "rows": {
      "max": 10
    },
    "rules": [
      "シーズン年 BETWEEN 2018 AND 2100",
      "ステージ IN ('regular', 'semifinal', 'final')",
      "チーム名 IS NOT NULL",
      "連続逆連対回数 >= 1",
      "記録開始日 GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'",
      "記録終了日 GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'",
      "記録開始日 <= 記録終了日"
    ]
  }
}
