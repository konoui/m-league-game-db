{
  "description": "シーズン・ステージ別のチーム別連続4着記録上位10件を取得するクエリ",
  "plan": [
    "各試合でのチームの最下位順位を特定し、4着かどうかを判定する",
    "チームごと・シーズン・ステージ別に試合を時系列順に並べる",
    "連続する4着記録をグループ化して連続回数を算出する",
    "連続4着記録の長さでソートし、上位10件を抽出する",
    "記録の開始日と終了日も併せて出力する"
  ],
  "tables": [
    "game_player_result",
    "player",
    "game",
    "season_stage",
    "league_season",
    "player_team",
    "team"
  ],
  "checks": {
    "unique": [
      "シーズン年",
      "ステージ",
      "チーム名",
      "記録開始日"
    ],
    "rows": {
      "max": 10
    },
    "rules": [
      "シーズン年 BETWEEN 2018 AND 2100",
      "ステージ IN ('regular', 'semifinal', 'final')",
      "チーム名 IS NOT NULL",
      "連続4位回数 >= 1",
      "記録開始日 GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'",
      "記録終了日 GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'",
      "記録開始日 <= 記録終了日"
    ]
  }
}
