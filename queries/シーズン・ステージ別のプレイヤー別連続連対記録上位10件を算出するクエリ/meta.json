{
  "description": "シーズン・ステージ別のプレイヤー別連続連対記録上位10件を算出するクエリ",
  "plan": [
    "シーズン・ステージ別にプレイヤーの連続連対記録を分析する",
    "連対は1着または2着の成績を指す",
    "各プレイヤーの試合を時系列順に並べて連続記録を特定する",
    "連続記録の長さ、開始日、終了日を算出する",
    "記録の長さで降順ソートして上位10件を抽出する"
  ],
  "tables": [
    "game_player_result",
    "player",
    "game",
    "season_stage",
    "league_season",
    "player_team",
    "team"
  ],
  "checks": {
    "unique": [
      "シーズン年",
      "ステージ",
      "プレイヤー名",
      "記録開始日"
    ],
    "rows": {
      "max": 10
    },
    "rules": [
      "シーズン年 BETWEEN 2018 AND 2100",
      "ステージ IN ('regular', 'semifinal', 'final')",
      "プレイヤー名 IS NOT NULL",
      "連続連対記録 >= 1",
      "記録開始日 GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'",
      "記録終了日 GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'",
      "記録開始日 <= 記録終了日"
    ]
  }
}
