{
  "description": "シーズン・ステージ別のチーム別連続連対記録を算出するクエリ",
  "plan": [
    "シーズン・ステージごとにチーム別の連続連対記録を算出する",
    "連対は1着または2着の成績を指す",
    "各試合でのチームの最高順位を基準に連対判定を行う",
    "連続記録のグループ化にはウィンドウ関数を使用",
    "記録の長さ順に上位10件を出力する"
  ],
  "tables": [
    "game_player_result",
    "player",
    "game",
    "season_stage",
    "league_season",
    "player_team",
    "team"
  ],
  "checks": {
    "unique": [
      "シーズン年",
      "ステージ",
      "チーム名",
      "記録開始日"
    ],
    "rows": {
      "max": 10
    },
    "rules": [
      "シーズン年 BETWEEN 2018 AND 2100",
      "ステージ IN ('regular', 'semifinal', 'final')",
      "チーム名 IS NOT NULL",
      "連続連対回数 >= 1",
      "記録開始日 GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'",
      "記録終了日 GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'",
      "記録開始日 <= 記録終了日"
    ]
  }
}
