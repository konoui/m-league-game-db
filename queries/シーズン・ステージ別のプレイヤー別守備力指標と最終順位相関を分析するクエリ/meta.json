{
  "description": "シーズン・ステージ別のプレイヤー別守備力指標と最終順位相関を分析するクエリ",
  "plan": [
    "放銃を避ける力が最終順位にどう結びつくかを、シーズン・ステージ別にプレイヤー単位で比較する",
    "放銃率はプレイヤーが参加した局のうち放銃した局の割合、和了率は和了した局の割合とする",
    "守備効率は放銃しなかった割合と連対率を掛け合わせた独自指標とし、放銃が少なく上位に入れているかを表す",
    "守備・攻撃の指標と順位成績（平均順位、1着・連対・4着の回数と率）を別々に集計してから、シーズン・ステージ・プレイヤーで突き合わせる",
    "試合数が10試合未満のプレイヤーは指標がぶれやすいため除外する",
    "結果はシーズン昇順、ステージ順、守備効率の降順で並べる"
  ],
  "tables": [
    "player",
    "game_player_result",
    "game",
    "season_stage",
    "league_season",
    "kyoku",
    "event",
    "agari_event"
  ],
  "checks": {
    "unique": [
      "season",
      "stage",
      "player_name"
    ],
    "rules": [
      "season BETWEEN 2018 AND 2100",
      "stage IN ('regular', 'semifinal', 'final')",
      "player_name IS NOT NULL",
      "total_games >= 10",
      "houjuu_rate BETWEEN 0 AND 100",
      "agari_rate BETWEEN 0 AND 100",
      "defensive_efficiency BETWEEN 0 AND 100",
      "rentai_rate BETWEEN 0 AND 100",
      "last_avoidance_rate BETWEEN 0 AND 100",
      "avg_rank BETWEEN 1 AND 4",
      "first_place_count <= rentai_count",
      "rentai_count <= total_games",
      "last_place_count <= total_games",
      "rentai_count + last_place_count <= total_games"
    ]
  }
}
