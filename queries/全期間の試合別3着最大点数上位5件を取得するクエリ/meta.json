{
  "description": "全期間の試合別3着最大点数上位5件を取得するクエリ",
  "plan": [
    "試合終了時に3着だったプレイヤーの持ち点が最も高いケースを特定する",
    "3着でありながら高得点であることは接戦の試合を示す指標となる",
    "試合結果から3着のレコードを抽出し、持ち点の降順で上位5件を取得する",
    "プレイヤー名、試合日、シーズン、ステージの付加情報を結合して出力する"
  ],
  "tables": [
    "game_player_result",
    "player",
    "game",
    "season_stage",
    "league_season"
  ],
  "checks": {
    "unique": [
      "試合日",
      "プレイヤー名"
    ],
    "rows": {
      "max": 5
    },
    "rules": [
      "シーズン GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]'",
      "ステージ IN ('regular', 'semifinal', 'final')",
      "試合日 GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'",
      "プレイヤー名 IS NOT NULL",
      "点数 BETWEEN -100000 AND 100000"
    ]
  }
}
