{
  "description": "シーズン・ステージ別のプレイヤー別リーチ成功率と最終順位相関を分析するクエリ",
  "plan": [
    "シーズン・ステージごとのプレイヤー別リーチ成功率を算出する",
    "同期間の各プレイヤーの平均順位と順位分布を集計する",
    "リーチ成功率を効率性カテゴリ（High/Medium/Low）に分類する",
    "平均順位を成績カテゴリ（Strong/Average/Weak）に分類する",
    "一定回数以上のリーチを行ったプレイヤーのみを対象とする",
    "リーチ成功率の高い順に結果を並べて相関関係を分析可能にする"
  ],
  "tables": [
    "league_season",
    "season_stage",
    "game",
    "kyoku",
    "event",
    "reach_event",
    "player",
    "player_team",
    "team",
    "game_player_result"
  ],
  "checks": {
    "unique": [
      "start_year",
      "stage",
      "player_name"
    ],
    "rules": [
      "start_year BETWEEN 2018 AND 2100",
      "stage IN ('regular', 'semifinal', 'final')",
      "player_name IS NOT NULL",
      "team_name IS NOT NULL",
      "total_reach_count >= 10",
      "successful_reach_count BETWEEN 0 AND total_reach_count",
      "reach_success_rate BETWEEN 0 AND 100",
      "top_rate BETWEEN 0 AND 100",
      "top2_rate BETWEEN 0 AND 100",
      "top_rate <= top2_rate",
      "total_games >= 1",
      "avg_rank BETWEEN 1 AND 4",
      "reach_efficiency_category IN ('High', 'Medium', 'Low')",
      "performance_category IN ('Strong', 'Average', 'Weak')"
    ]
  }
}
