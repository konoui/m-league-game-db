{
  "description": "シーズン・ステージ別のプレイヤー別連続逆連対回数上位10件を算出するクエリ",
  "plan": [
    "シーズン・ステージごとのプレイヤー別に連続逆連対（3着・4着）記録を分析する",
    "逆連対の定義：順位が3位以上（3着または4着）の結果",
    "各プレイヤーの試合を時系列順に並べ、連続する逆連対の回数を算出する",
    "連続記録の開始日と終了日も併せて記録する",
    "全シーズン・ステージを通じて最も長い連続逆連対記録上位10件を抽出する"
  ],
  "tables": [
    "game_player_result",
    "player",
    "game",
    "season_stage",
    "league_season",
    "player_team",
    "team"
  ],
  "checks": {
    "unique": [
      "シーズン年",
      "ステージ",
      "プレイヤー名",
      "記録開始日"
    ],
    "rows": {
      "max": 10
    },
    "rules": [
      "シーズン年 BETWEEN 2018 AND 2100",
      "ステージ IN ('regular', 'semifinal', 'final')",
      "プレイヤー名 IS NOT NULL",
      "連続逆連対回数 >= 1",
      "記録開始日 GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'",
      "記録終了日 GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'",
      "記録開始日 <= 記録終了日"
    ]
  }
}
