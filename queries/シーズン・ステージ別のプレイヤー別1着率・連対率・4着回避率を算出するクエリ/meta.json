{
  "description": "シーズン・ステージ別のプレイヤー別1着率・連対率・4着回避率を算出するクエリ",
  "plan": [
    "シーズン・ステージごとに、各プレイヤーがどれだけ上位の着順を取れているかを明らかにする",
    "1着率は1着の回数、連対率は1着または2着の回数、4着回避率は4着以外の回数を、それぞれ試合数で割った百分率とする",
    "シーズン・ステージ・プレイヤー単位で集計済みの成績をそのまま使い、着順ごとの回数と率を並べて出力する",
    "セミファイナルやファイナルは試合数が少なく率が大きく振れるため、試合数を併記する。順位づけに使うときは試合数の下限を置く",
    "通算の率を出すときは、率を平均せず、回数と試合数をそれぞれ合計してから割る",
    "結果はシーズンの新しい順、ステージ順、1着率の高い順で並べる"
  ],
  "tables": [
    "player_season_stage_stats",
    "agari_event",
    "agari_yaku",
    "chi_event",
    "daiminkan_event",
    "event",
    "game",
    "game_player_result",
    "kyoku",
    "kyoku_player_result",
    "league_season",
    "player",
    "player_season_stage_stats_base",
    "pon_event",
    "reach_event",
    "ryukyoku_player",
    "season_stage",
    "team",
    "yaku_name"
  ],
  "checks": {
    "unique": [
      "シーズン",
      "ステージ",
      "プレイヤー名"
    ],
    "rules": [
      "シーズン GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]'",
      "ステージ IN ('regular', 'semifinal', 'final')",
      "プレイヤー名 IS NOT NULL",
      "チーム名 IS NOT NULL",
      "ポイント IS NOT NULL",
      "試合数 >= 1",
      "\"1着回数\" + \"2着回数\" + \"3着回数\" + \"4着回数\" = 試合数",
      "\"1着率\" BETWEEN 0 AND 100",
      "連対率 BETWEEN 0 AND 100",
      "\"4着回避率\" BETWEEN 0 AND 100",
      "\"1着率\" <= 連対率",
      "ABS(\"1着率\" - \"1着回数\" * 100.0 / 試合数) <= 0.01",
      "ABS(連対率 - (\"1着回数\" + \"2着回数\") * 100.0 / 試合数) <= 0.01",
      "ABS(\"4着回避率\" - (試合数 - \"4着回数\") * 100.0 / 試合数) <= 0.01"
    ]
  }
}
